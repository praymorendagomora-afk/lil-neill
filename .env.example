# WhatsApp number used for pairing-code login (digits only, with country code)
# Example: 12025550123
BOT_NUMBER=your_whatsapp_number_here

# Optional: owner number for privileged commands (digits only, with country code)
OWNER_NUMBER=your_owner_number_here

# HTTP port for the health server (Koyeb / Render / VPS)
PORT=3000

# Optional AI REST API (OpenAI-compatible). Leave empty to disable .gemini / .gpt
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.groq.com/openai/v1
USER_LLM_MODEL=llama-3.1-8b-instant

# Optional Cobalt instance (defaults to the public API)
COBALT_API_URL=https://api.cobalt.tools
